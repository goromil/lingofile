{
  "name": "lingofile",
  "displayName": "LingoFile — Large File Linguistic Viewer",
  "description": "View, decode, and analyse large text files — languages, scripts, encodings, zones.",
  "version": "0.2.9",
  "publisher": "gorom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goromil/lingofile"
  },
  "keywords": [
    "large-file",
    "encoding",
    "language-detection",
    "script-analysis",
    "zone-scan",
    "hex-viewer",
    "text-analysis"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "files": [
    "out",
    "node_modules"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lingofile.open",
        "title": "Open Large File",
        "icon": "$(preview)"
      },
      {
        "command": "lingofile.openActive",
        "title": "Open Active File"
      },
      {
        "command": "lingofile.previewFile",
        "title": "Preview with LingoFile",
        "icon": "$(preview)"
      },
      {
        "command": "lingofile.focusSearch",
        "title": "Focus Search",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.focusOffset",
        "title": "Go To Offset",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.toggleWrap",
        "title": "Toggle Wrap",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.reloadChunk",
        "title": "Reload Chunk",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.nextPage",
        "title": "Next Page",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.prevPage",
        "title": "Previous Page",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.abortOperation",
        "title": "Abort Operation",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.toggleSlider",
        "title": "Toggle Position Slider",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.analyseChunk",
        "title": "Analyse Chunk",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.analyseZones",
        "title": "Analyse Zones (Fast)",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.analyseZonesFull",
        "title": "Analyse Zones (Full)",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.saveMeta",
        "title": "Save Analysis (Metafile)",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.loadMeta",
        "title": "Load Metafile",
        "category": "LingoFile"
      },
      {
        "command": "lingofile.runBenchmark",
        "title": "Run I/O Benchmark",
        "category": "LingoFile"
      }
    ],
    "keybindings": [
      {
        "command": "lingofile.focusSearch",
        "key": "ctrl+f",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.focusOffset",
        "key": "ctrl+g",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.toggleWrap",
        "key": "alt+z",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.reloadChunk",
        "key": "ctrl+alt+r",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.nextPage",
        "key": "pagedown",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.prevPage",
        "key": "pageup",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.abortOperation",
        "key": "escape",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.toggleSlider",
        "key": "ctrl+alt+l",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.analyseChunk",
        "key": "ctrl+alt+a",
        "when": "lingofile.active"
      },
      {
        "command": "lingofile.analyseZones",
        "key": "ctrl+alt+z",
        "when": "lingofile.active"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "lingofile.previewFile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "lingofile@1"
        }
      ],
      "editor/context": [
        {
          "command": "lingofile.previewFile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "lingofile@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "lingofile.openActive",
          "group": "lingofile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote"
        }
      ]
    },
    "configuration": [
      {
        "title": "LingoFile",
        "properties": {
          "lingofile.zoneScanConcurrency": {
            "type": "number",
            "enum": [
              1,
              2,
              8
            ],
            "enumDescriptions": [
              "Sequential (HDD)",
              "Low (SSD)",
              "High (NVMe)"
            ],
            "default": 2,
            "description": "Number of concurrent reads during zone scanning. Use 1 for HDD/WSL, 2 for SSD, 8 for NVMe."
          },
          "lingofile.sigmaThreshold": {
            "type": "number",
            "default": 3,
            "minimum": 0.5,
            "maximum": 20,
            "description": "Sigma multiplier for slow-read detection. Threshold = sigmaThreshold × CV × mean. Uses CV from benchmark (or default 0.5). Default 3 catches outliers. Health indicators auto-calibrate after running I/O benchmark."
          },
          "lingofile.maxCv": {
            "type": "number",
            "default": 0.5,
            "minimum": 0.01,
            "maximum": 10,
            "description": "Default healthy CV baseline. Actual maxHealthyCV = 2 × maxCv (or 2 × benchCV after benchmark). Before benchmark: maxHealthyCV=1.0. After benchmark: recalibrated from measured CV."
          },
          "lingofile.zoneScanExcludeScripts": {
            "type": "array",
            "default": ["Binary"],
            "items": { "type": "string" },
            "description": "Scripts to exclude from zone-scan language detection. Zones matching these scripts are tagged 'Skipped' without running franc-min. Default: Binary."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./ && node -e \"require('fs').copyFileSync('src/webview.html','out/webview.html')\"",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npx mocha --ui tdd out/test/utils.test.js",
    "test:vscode": "npm run compile && node ./out/test/runTest.js",
    "coverage": "npm run compile && npx c8 --reporter=lcov --reporter=text npx mocha --ui tdd out/test/utils.test.js",
    "build": "npm run compile && npm test",
    "prepublish": "npx vsce package",
    "benchmark": "npm run compile && node out/benchmark.js"
  },
  "devDependencies": {
    "@types/iconv-lite": "^0.0.1",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.0",
    "c8": "^9.0.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "franc-min": "^6.2.0",
    "iconv-lite": "^0.7.3"
  }
}
